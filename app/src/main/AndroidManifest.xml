<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AssistiveTouch">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating Overlay Widget Service -->
        <service
            android:name=".FloatingWidgetService"
            android:enabled="true"
            android:exported="false" />

        <!-- Quick Controls Notification Service -->
        <service
            android:name=".ControlNotificationService"
            android:enabled="true"
            android:exported="false" />

        <!-- Broadcast Receiver for Notification Action Buttons -->
        <receiver
            android:name=".ActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.assistivetouch.ACTION_VOL_UP" />
                <action android:name="com.assistivetouch.ACTION_VOL_DOWN" />
                <action android:name="com.assistivetouch.ACTION_LOCK_SCREEN" />
                <action android:name="com.assistivetouch.ACTION_POWER_MENU" />
            </intent-filter>
        </receiver>

        <!-- Device Admin Receiver for Locking Screen (Supports Android 8.1) -->
        <receiver
            android:name=".DeviceAdminManager"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Accessibility Service for Power Dialog & Lock Screen -->
        <service
            android:name=".ActionAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
